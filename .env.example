# PALM-GeM environment variable overrides
# Copy this file to .env and fill in your values.
# All variables are optional — they override the database section in your user YAML.

# PostgreSQL connection
PALM_GEM_DB_HOST=localhost
PALM_GEM_DB_PORT=5432
PALM_GEM_DB_USER=postgres
PALM_GEM_DB_PASSWORD=postgres
PALM_GEM_DB_NAME=palm_static

# Database owner role (used for schema ownership)
PALM_GEM_PG_OWNER=postgres
